{:source-paths ["src"]

 :dependencies [[reagent "2.0.1"]
                [metosin/reitit-frontend "0.6.0"]]

 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "/js"
                :modules {:main {:entries [wejure.core]}}
                :devtools {:before-load wejure.core/stop
                           :after-load wejure.core/start
                           :http-root "public"
                           :http-port 8020}}}}
